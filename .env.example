# Naukri Bot Configurations

# Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Automation Settings
DRY_RUN=true
MIN_DELAY_BETWEEN_APPLICATIONS=10000
MAX_DELAY_BETWEEN_APPLICATIONS=30000
MAX_APPLICATIONS_PER_RUN=20
MAX_APPLICATIONS_PER_DAY=40

# Job Search Filters
# Comma-separated lists
KEYWORDS=MERN Stack Developer,Full Stack Developer,Node.js Developer,React Developer,Backend Developer,Software Engineer
LOCATIONS=Bangalore,Bengaluru,Hyderabad,Pune,Remote
# Experience: Choose 0 (Fresher), 1 (1 Year), 2 (2 Years), etc. OR experience string for search
# Naukri experience search uses query: experience=0 (or 1, 2, etc.)
# We will map "Fresher" to 0, "0-1 years" to 0 or 1.
JOB_EXPERIENCE_FILTER_IDS=0,1

# Personal Details for Questionnaire Autosolve
MY_NAME=Your Full Name
MY_EMAIL=your.email@example.com
MY_PHONE=9999999999
MY_RESUME_PATH=C:\path\to\your\resume.pdf
MY_LOCATION=Bengaluru
MY_NOTICE_PERIOD=Immediate
MY_CURRENT_SALARY=0
MY_EXPECTED_SALARY=600000
MY_EDUCATION=Bachelor of Engineering
MY_TOTAL_EXPERIENCE=1
